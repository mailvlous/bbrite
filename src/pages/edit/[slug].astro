---
import Layout from '../../layouts/Layout.astro';
import Writer from '../../components/Writer.astro';
import { getPost } from '../../lib/github';
import { getEnv } from '../../lib/runtime';
const post = await getPost(getEnv(), Astro.params.slug!);

if (!post) {
  return Astro.redirect('/404');
}
---
<Layout title={post.title}><Writer post={post} /></Layout>
