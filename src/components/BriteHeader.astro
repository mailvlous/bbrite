---
export interface Props {
  title?: string;
  showNav?: boolean;
  currentPage?: string;
}

const { title = "Bbrite", showNav = true, currentPage } = Astro.props;
---

<header class="bbrite-header">
  <div class="header-content">
    <div class="branding">
      <a href="/drafts" class="bbrite-logo">{title}</a>
    </div>

    {showNav && (
      <nav class="header-nav" aria-label="Main navigation">
        <a href="/posts" class:list={["nav-link", { active: currentPage === "posts" }]}>Posts</a>
        <a href="/drafts" class:list={["nav-link", { active: currentPage === "drafts" }]}>Drafts</a>
        <a href="/new" class:list={["nav-link primary", { active: currentPage === "new" }]}>New</a>
      </nav>
    )}
  </div>
</header>

<style>
  .bbrite-header {
    border-bottom: 2px solid var(--border);
    background: var(--background);
    padding: 1.2rem 2rem;
  }

  .header-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .branding {
    flex: 1;
  }

  .brite-logo,
  .bbrite-logo {
    display: inline-block;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    font-weight: 400;
    letter-spacing: 0;
    margin: 0;
    font-family: var(--font-display);
    color: var(--foreground);
    text-decoration: none;
  }

  .bbrite-logo:hover { color: var(--foreground); }

  .header-nav {
    display: flex;
    gap: 1.1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-link {
    text-decoration: none;
    color: var(--foreground);
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0;
    padding: 0.65rem 1rem;
    border: 2px solid transparent;
    border-radius: 999px;
    border-bottom: 2px solid transparent;
    transition: all 200ms ease;
  }

  .nav-link:hover {
    color: var(--accent-1);
  }

  .nav-link.active {
    border-color: var(--foreground);
    color: var(--accent-1);
  }

  .nav-link.primary {
    background: var(--surface);
    color: var(--foreground);
    border-color: var(--foreground);
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    border-bottom: none;
    letter-spacing: 0;
  }

  .nav-link.primary:hover {
    opacity: 0.94;
    color: #fffaf4;
  }

  .nav-link.primary.active {
    border-bottom: none;
  }

  @media (max-width: 768px) {
    .bbrite-header {
      padding-inline: 1rem;
    }

    .header-content {
      flex-direction: column;
      gap: 0.9rem;
      align-items: flex-start;
    }

    .header-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .nav-link {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }
  }
</style>
