---
export interface Props {
  title: string;
  excerpt?: string;
  tags?: string[];
  date?: string;
  href: string;
  folder?: string;
  isEditable?: boolean;
}

const { title, excerpt, tags = [], date, href, folder = "", isEditable = false } = Astro.props;
---

<article class="card">
  <a href={href} class="card-link">
    {folder && <div class="card-folder" title={folder}>📁 {folder}</div>}
    <h3 class="card-title">{title}</h3>
    {excerpt && <p class="card-excerpt">{excerpt}</p>}
  </a>

  <div class="card-footer">
    {date && <time class="card-date">{new Date(date).toLocaleDateString()}</time>}

    {tags && tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => (
          <span class="tag-pill">{tag}</span>
        ))}
      </div>
    )}
  </div>

  {isEditable && (
    <div class="card-actions">
      <a href={href} class="action-link">Edit</a>
    </div>
  )}
</article>

<style>
  .card {
    background: rgba(255, 255, 255, 0.42);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 1.4rem 1.35rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 200ms ease;
    box-shadow: 0 10px 18px rgba(34, 27, 22, 0.03);
  }

  .card:hover {
    border-color: rgba(122, 77, 58, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 14px 26px rgba(34, 27, 22, 0.06);
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    flex: 1;
  }

  .card-title {
    font-size: clamp(1.6rem, 2vw, 2rem);
    font-weight: 600;
    margin: 0 0 0.5rem 0;
    color: var(--foreground);
    line-height: 0.98;
  }

  .card-folder {
    margin-bottom: 0.8rem;
    color: var(--accent-1);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card-excerpt {
    color: var(--darkgray);
    font-size: 0.96rem;
    line-height: 1.6;
    margin: 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 0.9rem;
  }

  .card-date {
    font-size: 0.76rem;
    color: var(--gray);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag-pill {
    display: inline-block;
    background: rgba(201, 110, 77, 0.12);
    color: var(--accent-1);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-actions {
    display: flex;
    gap: 0.5rem;
  }

  .action-link {
    padding: 0.4rem 0.8rem;
    font-size: 0.85rem;
    background: var(--surface-strong);
    color: var(--accent-1);
    border: 1px solid var(--accent-1);
    border-radius: 6px;
    text-decoration: none;
    transition: all 200ms ease;
  }

  .action-link:hover {
    background: var(--accent-1);
    color: white;
  }
</style>
