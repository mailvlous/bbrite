<div class="markdown-toolbar" role="toolbar" aria-label="Markdown formatting">
  <button type="button" data-format="bold" title="Bold"><strong>B</strong></button>
  <button type="button" data-format="italic" title="Italic"><em>I</em></button>
  <button type="button" data-format="quote" title="Blockquote">❝</button>
  <button type="button" data-format="link" title="Link">↗</button>
  <button type="button" data-format="inline-code" title="Inline code">&lt;/&gt;</button>
  <button type="button" data-format="code-block" title="Code block">{ }</button>
  <button type="button" data-format="bullet-list" title="Bulleted list">☷</button>
  <button type="button" data-format="number-list" title="Numbered list">☷</button>
  <button type="button" data-format="strike" title="Strikethrough"><s>S</s></button>
  <button type="button" data-format="task" title="Task list">☑</button>
  <button type="button" data-format="math" title="Math">∑</button>
  <button type="button" data-upload-pdf title="Upload PDF">PDF</button>
  <input data-pdf-input type="file" accept="application/pdf,.pdf" hidden />
</div>

<script>
  type Format = { prefix: string; suffix: string; placeholder: string };

  const toolbar = document.querySelector<HTMLElement>(".markdown-toolbar");
  const editor = document.getElementById("editor-content") as HTMLTextAreaElement | null;
  const pdfButton = toolbar?.querySelector<HTMLButtonElement>("[data-upload-pdf]");
  const pdfInput = toolbar?.querySelector<HTMLInputElement>("[data-pdf-input]");

  const formats: Record<string, Format> = {
    bold: { prefix: "**", suffix: "**", placeholder: "bold text" },
    italic: { prefix: "*", suffix: "*", placeholder: "italic text" },
    strike: { prefix: "~~", suffix: "~~", placeholder: "struck text" },
    "inline-code": { prefix: "`", suffix: "`", placeholder: "code" },
    link: { prefix: "[", suffix: "](https://)", placeholder: "link text" },
    math: { prefix: "$", suffix: "$", placeholder: "x^2" },
  };

  function replaceSelection(format: Format) {
    if (!editor) return;

    const start = editor.selectionStart;
    const end = editor.selectionEnd;
    const selected = editor.value.slice(start, end);
    const value = selected || format.placeholder || "text";
    const replacement = `${format.prefix}${value}${format.suffix}`;

    editor.setRangeText(replacement, start, end, "select");
    editor.focus();
    editor.dispatchEvent(new Event("input", { bubbles: true }));
  }

  function prefixLines(prefix: string, placeholder: string) {
    if (!editor) return;

    const start = editor.selectionStart;
    const end = editor.selectionEnd;
    const lineStart = editor.value.lastIndexOf("\n", start - 1) + 1;
    const lineEndIndex = editor.value.indexOf("\n", end);
    const lineEnd = lineEndIndex === -1 ? editor.value.length : lineEndIndex;
    const selected = editor.value.slice(lineStart, lineEnd) || placeholder;
    const replacement = selected
      .split("\n")
      .map((line) => `${prefix}${line}`)
      .join("\n");

    editor.setRangeText(replacement, lineStart, lineEnd, "select");
    editor.focus();
    editor.dispatchEvent(new Event("input", { bubbles: true }));
  }

  function displayName(filename: string): string {
    return filename.replace(/\.pdf$/i, "").replace(/[-_]+/g, " ").trim() || "Open PDF";
  }

  async function uploadPdf(file: File) {
    if (!editor) return;
    if (file.type !== "application/pdf" && !file.name.toLowerCase().endsWith(".pdf")) return;

    const status = document.getElementById("save-status");
    if (file.size === 0 || file.size > 10 * 1024 * 1024) {
      window.showToast?.("PDF must be between 1 byte and 10 MB.", "error");
      return;
    }

    if (status) status.textContent = "Uploading PDF...";
    pdfButton?.setAttribute("disabled", "");
    try {
      const form = new FormData();
      form.append("asset", file, file.name || "document.pdf");
      const response = await fetch("/api/assets", { method: "POST", body: form });
      const payload = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(payload.error || "PDF upload failed");

      const markdown = `![[assets/${payload.filename}|${displayName(file.name)}]]`;
      editor.setRangeText(markdown, editor.selectionStart, editor.selectionEnd, "end");
      editor.focus();
      editor.dispatchEvent(new Event("input", { bubbles: true }));
      if (status) status.textContent = "PDF uploaded";
      window.showToast?.("PDF uploaded and inserted", "success");
    } catch (error) {
      if (status) status.textContent = "Upload error";
      window.showToast?.(error instanceof Error ? error.message : "PDF upload failed", "error");
    } finally {
      pdfButton?.removeAttribute("disabled");
      if (pdfInput) pdfInput.value = "";
    }
  }

  toolbar?.addEventListener("mousedown", (event) => {
    event.preventDefault();
  });

  toolbar?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("button[data-format]");
    if (!button) return;

    const formatName = button.dataset.format;
    if (formatName === "quote") return prefixLines("> ", "quoted text");
    if (formatName === "bullet-list") return prefixLines("- ", "list item");
    if (formatName === "number-list") return prefixLines("1. ", "list item");
    if (formatName === "task") return prefixLines("- [ ] ", "task item");
    if (formatName === "code-block") return replaceSelection({ prefix: "```\n", suffix: "\n```", placeholder: "code" });

    const format = formatName ? formats[formatName] : undefined;
    if (format) replaceSelection(format);
  });

  pdfButton?.addEventListener("click", () => pdfInput?.click());
  pdfInput?.addEventListener("change", () => {
    const file = pdfInput.files?.[0];
    if (file) uploadPdf(file);
  });

  editor?.addEventListener("dragover", (event) => {
    if (Array.from(event.dataTransfer?.items || []).some((item) => item.type === "application/pdf")) {
      event.preventDefault();
      event.dataTransfer!.dropEffect = "copy";
    }
  });
  editor?.addEventListener("drop", (event) => {
    const pdf = Array.from(event.dataTransfer?.files || []).find(
      (file) => file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf"),
    );
    if (!pdf) return;
    event.preventDefault();
    uploadPdf(pdf);
  });
  editor?.addEventListener("paste", (event) => {
    const pdf = Array.from(event.clipboardData?.files || []).find(
      (file) => file.type === "application/pdf" || file.name.toLowerCase().endsWith(".pdf"),
    );
    if (!pdf) return;
    event.preventDefault();
    uploadPdf(pdf);
  });
</script>

<style>
  .markdown-toolbar {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    min-height: 3.25rem;
    padding: 0.45rem 1rem;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }

  .markdown-toolbar button {
    flex: 0 0 2.35rem;
    width: 2.35rem;
    height: 2.35rem;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--foreground);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
  }

  .markdown-toolbar button:hover,
  .markdown-toolbar button:focus-visible {
    background: var(--surface-strong);
    outline: none;
  }

  .markdown-toolbar button:nth-child(5),
  .markdown-toolbar button:nth-child(6) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .markdown-toolbar button[data-upload-pdf] {
    width: auto;
    min-width: 3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }
</style>
