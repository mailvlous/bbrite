{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bbrite",
	"compatibility_date": "2026-08-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bbrite-db",
      "database_id": "b0e68bf0-b763-4f32-9830-88e1251c9e0f",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "53cd789d21ed4010b3a0f1a9b0d0c43c"
		}
	],
	"vars": {
		"GITHUB_OWNER": "mailvlous",
		"GITHUB_REPO": "garden",
		"GITHUB_BRANCH": "v4",
		"CONTENT_PATH": "content",
		"ACCESS_TEAM_DOMAIN": "mailvelous.cloudflareaccess.com",
		"ACCESS_AUD": "1c063ac0a0e27cea17ecac177d22562828bf45204500bc031d82925f56fdf6a1",
		"ACCESS_ALLOWED_EMAIL": "mailvelous.career@gmail.com"
	}
}
