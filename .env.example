# Cloudflare Configuration
GITHUB_OWNER=mailvlous
GITHUB_REPO=garden
GITHUB_BRANCH=v4
CONTENT_PATH=content

# Cloudflare Access (required for every route and API endpoint)
# Team domain, e.g. my-team.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
# Access Application audience tag (from the Access application settings, used as the Worker AUD binding)
ACCESS_AUD=
# The one Cloudflare Access identity allowed to use Bbrite
ACCESS_ALLOWED_EMAIL=

# GitHub Token (set in Cloudflare secrets, not here!)
# GITHUB_TOKEN=your_github_personal_access_token
